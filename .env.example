# kuryeler.tr — Vite derleme zamanı değişkenleri (Turhost'a yüklenen statik dosyalara gömülür)
# Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# İletişim (landing WhatsApp / telefon). WhatsApp: başında + yok.
VITE_WHATSAPP_NUMBER=905324746745
VITE_CONTACT_EMAIL=iletisim@kuryeler.tr
VITE_CONTACT_PHONE=0532 474 67 45

# İsteğe bağlı OpenRouteService (boşsa ücretsiz OSRM sürüş rotası kullanılır)
# VITE_ORS_API_KEY=

# Vitrin modu: kayıt ve sipariş kapalı, yalnızca tanıtım + TL tarife + telefon
# VITE_VITRIN_MODU=true

# iyzico — yalnız Edge Function / sunucu. VITE_IYZICO_* YAZMAYIN.
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=
# IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# IYZICO_CALLBACK_URL=

# İsteğe bağlı: eski Run Courier Express sunucusu (Turhost statik kurulumunda gerekmez)
# DATABASE_URL=
# JWT_SECRET=
# OAUTH_SERVER_URL=
