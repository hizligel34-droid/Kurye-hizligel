# kuryeler.tr — Vite derleme zamanı değişkenleri (Turhost'a yüklenen statik dosyalara gömülür)
# Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# İletişim e-postası. Telefon/WhatsApp: shared/contactConfig.ts (0553 255 67 45).
VITE_CONTACT_EMAIL=serif.tekin@hotmail.com

# İsteğe bağlı OpenRouteService (boşsa ücretsiz OSRM sürüş rotası kullanılır)
# VITE_ORS_API_KEY=

# Vitrin modu: kayıt ve sipariş kapalı, yalnızca tanıtım + TL tarife + telefon
# VITE_VITRIN_MODU=true

# Yerel önizleme: 1 iken Supabase olsa da demo deposu kullanılır (canlıya koymayın)
# VITE_DEMO=1

# iyzico — yalnız Edge Function / sunucu. VITE_IYZICO_* YAZMAYIN.
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=
# IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# IYZICO_CALLBACK_URL=

# İsteğe bağlı: eski Run Courier Express sunucusu (Turhost statik kurulumunda gerekmez)
# DATABASE_URL=
# JWT_SECRET=
# OAUTH_SERVER_URL=
